{
  "name": "relay",
  "version": "0.1.0",
  "private": true,
  "workspaces": ["packages/*"],
  "scripts": {
    "build": "bun run --filter '*' build",
    "core": "bun run --filter relay-core start",
    "mcp": "bun run packages/relay-mcp/src/main.ts",
    "daemon": "bun run packages/relay-daemon/src/main.ts",
    "tui": "bun run --filter relay-tui start",
    "compile": "bun build --compile packages/relay-cli/src/main.ts --outfile dist/relay",
    "install:binary": "bun run compile && bun run scripts/install-binary.ts",
    "bench": "bun run scripts/bench/run.ts",
    "test": "bun test"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "bun-types": "^1.1.38",
    "effect": "3.22.5",
    "typescript": "^5.7.2"
  }
}
